
<div class="pattern-center-blank">
</div>
<div class="pattern-center ">
  <div class="pattern-attachment-img">
    <% if (page.photos) { %>
    <img src="<%= page.photos %>" src="<%- theme.lazyloadImg %>" data-src="<%= page.photos %>" class="lazyload" onerror="imgError(this,3)" style="width: 100%; height: 100%; object-fit: cover; pointer-events: none;">
    <% } else { %>
      <img src="<%= theme.bg[Math.floor(Math.random() * theme.bg.length + 1)-1] %>" src="<%- theme.lazyloadImg %>" data-src="<%= page.photos %>" class="lazyload" onerror="imgError(this,3)" style="width: 100%; height: 100%; object-fit: cover; pointer-events: none;">
    <% } %>
  </div>
  <header class="pattern-header ">
    <h1 class="entry-title">
    微语</h1>
    <span class="post-meta-item-icon">
    <i class="iconfont icon-attention"></i>
    </span>
    <span class="post-meta-item-text">本页共<span id="busuanzi_value_page_pv"> </span>次阅读
    </span>
  </header>
  <%- partial('_partial/waves') %>
</div>
<div class="allparts justify-content-center flex-row-reverse">
  <%- partial('_partial/sidebarpage') %>
  <div id="content" class="site-content">
    <div id="artitalktitle" style="margin: 2rem; margin-bottom: -2rem;margin-left: -0.5rem;">
      <span class="fa fa-comments">
        <span style="font-family: 'kitty';">  动态</span>
      </span>
    </div>
    <article class="post-item post-301 page type-page status-publish has-post-thumbnail hentry">
      <div >
        <!-- artitalk more: https://artitalk.js.org/doc.html -->
        <div id="artitalk_main" style="padding-top: 25px;"></div>
        <script>
        /* artitalk 按需加载：首次进入说说页才拉 artitalk.min.js（见 head.ejs 的 LazyLib） */
        LazyLib.load('artitalk').then(function () {
          if (!document.getElementById('artitalk_main')) return   // 加载期间已经翻页走了
          new Artitalk({
            backend: 'vercel',   
            serverURL: "<%- theme.artitalk.serverurl %>",
            motion: "<%- theme.artitalk.motion %>",
            bgImg: "<%- theme.artitalk.bgimg %>",
            pageSize: "<%- theme.artitalk.pageSize %>",
            serverURL: '<%- theme.artitalk.serverurl %>',
            shuoPla: '这是若儿的地盘哦',
          })
        }).catch(function (e) { console.error('[artitalk]', e) })
        </script>
        <!-- artitalk.end -->
        <script>
          $('path').css('fill', '');
        </script>
      </div>
      <footer class="post-footer">
        <div class="post-lincenses" style="color: #ff9966;">
          欢迎转载，转载时请注明来源哦！
          <br>
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" target="_blank" rel="nofollow">
            <i class="fa fa-creative-commons" aria-hidden="true"></i>知识共享署名-非商业性使用-相同方式共享 4.0 国际许可协议</a>
        </div>
        <div class="post-tags">
        </div>
        <div class="post-share">
          <div class="social-share sharehidden share-component"></div>
          <i class="iconfont show-share icon-forward"></i>
        </div>
      </footer>
      <!-- .entry-footer -->
    </article>
  </div>
</div>
<!-- 自定义样式 -->
<style>
  #content > div > span{
    margin-top: 60px;
    margin-left: 8px;
    font-size: 30px;
  }
  #artitalk_main #shuoshuo_content{
    padding-left: 30px;
  }
  #artitalk_main ul#maina>li{
    padding-top: 15px;
  }
  #artitalk_main .cbp_tmtimeline>li:nth-child(odd) .cbp_tmlabel {
    color: white;
  }
  #artitalk_main .cbp_tmtimeline>li .cbp_tmlabel {
    color: white;
  }
  #artitalk_main .cbp_tmtimeline>li:nth-child(odd) .cbp_tmlabel:after {
    border-right-color:  #f1ac9d
  }
  #artitalk_main .cbp_tmtimeline>li .cbp_tmlabel:after{
    border-right-color: #8ab68a;
  }
  .cbp_tmtimeline>li .cbp_tmlabel:after {
    border-right-color:  #dee2d1
  }
  #artitalk_main #lazy{
    top:20px;
    border-radius: 40px;
  }
  .button {
    background: linear-gradient(130deg, #f1ac9d, #f06966, #dee2d1, #6abe83) 0% 0% / 400% 400% ;
    animation: 15s ease 0s infinite normal none running gradientBG;
    color: white;
  }
  #artitalk_main .at_button {
    background: linear-gradient(130deg, #f1ac9d, #f06966, #dee2d1, #6abe83) 0% 0% / 400% 400% ;
    animation: 12s ease 0s infinite normal none running gradientBG;
    color: white;
  }
  #artitalk_main .shuoshuo_text{
    background-image: url(https://cdn.jsdelivr.net/gh/weilining/img@main/img/valinebg.webp) !important;
    background-position: right !important;
    height: 180px;
    background-color:rgb(255, 255, 255);
  }
  #artitalk_main .shuoshuo_author_img img {
    height: 55px;
    width: 55px;
    margin: -8px 0 0 -2px;
  }
  @keyframes gradientBG {
      0% {
          background-position: 0% 50%;
      }
      50% {
          background-position: 100% 50%;
      }
      100% {
          background-position: 0% 50%;
      }
  }
  #shuoshuo_edit{
    padding: 0 20px 0 20px;
  }
  #pubShuo,#switchUser,#uploadSource{
    margin-left: 9px;
  }
  #artitalk_main{
    padding-top: 40px !important;
  }
</style>
<!-- 自定义样式.end -->
  