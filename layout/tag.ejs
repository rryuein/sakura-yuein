<div class="pattern-center-blank"></div>
<div class="pattern-center ">
  <div class="pattern-attachment-img">
    <img src="https://tenapi.cn/acg" class="lazyload" onerror="imgError(this,3)" style="width: 100%; height: 100%; object-fit: cover; pointer-events: none;">
  </div>
  <header class="pattern-header ">
    <h1 class="cat-title"><%= __(page.tag) %></h1>
    <br>
    <span class="post-meta-item-icon">
      <i class="iconfont icon-attention"></i>
    </span>
      <span class="post-meta-item-text">本页共<span id="busuanzi_value_page_pv"> </span>次阅读
    </span>
  </header>
  <%- partial('_partial/waves') %>
</div>
<div class="allparts justify-content-center flex-row-reverse">
  <%- partial('_partial/sidebarpage') %>
  <div id="content" class="site-content">
    <div id="primary" class="content-area">
      <main id="main" class="site-main" role="main">
        <%- partial('_partial/category-archive', {pagination: 2, index: true}) %>
        <div class="clearer">
        </div>
      </main>
      <% if (page.total > 1 && page.next_link){ %>
        <div id="pagination"><a href="<%- url_for(page.next_link) %>" class="">Previous</a></div>
      <% } %>
    </div>
    <div style="text-align:center; width: 100%" class="social-share share-mobile" data-disabled="diandian, tencent">
    </div>
    <footer class="post-footer">
      <div class="post-lincenses" style="color: #ff9966;">
        欢迎转载，转载时请注明来源哦！
        <br>
        <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" target="_blank" rel="nofollow">
          <i class="fa fa-creative-commons" aria-hidden="true"></i>知识共享署名-非商业性使用-相同方式共享 4.0 国际许可协议</a>
      </div>
      <div class="post-tags">
      </div>
      <div class="post-share">
        <div class="social-share sharehidden share-component"></div>
        <i class="iconfont show-share icon-forward"></i>
      </div>
    </footer>
    <!-- .entry-footer -->
    
  </div>  
</div>
<style>
    .post-meta {
      float: right;
      padding-left: 0px;
      padding-right: 20px;
      max-width: 200px;
      padding-top: 55px;
      text-align: right;
      margin: 0 0 0 0
    }
    .post-meta p{
      min-height: 5px;
    }
    .post-list {
      float: left;
      width: 100%;
      height: 160px;
      position: relative;
      margin: 20px 0 20px;
      border-radius: 10px;
      background-color: rgba(255, 255, 255, 0.484);
      box-shadow: 0 1px 20px -6px rgba(0, 0, 0, .5);
      transition: box-shadow .3s ease;
    }
    .post-list::after {
      content: "";
      border-radius: 10px;
      position: absolute;
      z-index: -1;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      box-shadow: -1px 6px 8px 4px rgb(0 0 0 / 81%);
      opacity: 0;
      -webkit-transition: all 1.2s cubic-bezier(0.165, 0.84, 0.44, 1);
      transition: all 1.2s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .post-list:hover::after {
        opacity: 1;
    } 
    .p-time {
      right: 20px;
    }
    .post-more {
      padding-right: 20px;
    }
    .feature {
      margin-left: 10px;
      margin-top: 20px;
    }
    .post-list h1.entry-title{
      margin: 15px 0 0 17%;
      width: 50%;
    }
    .entry-footer {
      margin: -11px 0 0 17%;
    }
    .post-list p {
      margin: 0 0 0 19%;
      max-width: 430px;
      width: 60%;
    }
    .feature i {
      background: #ffd3d36e;
    }
    .overlay {
      height: 120px;
      width: 120px;
      overflow: hidden;
      margin-left: -5px;
    }
    .feature img {
      height: 100%;
      width: 100%;
      object-fit: cover;
    }
</style>
